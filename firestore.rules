rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read and write for employees collection
    match /employees/{employeeId} {
      allow read, write: if true;
    }
    
    // Allow read and write for territory profiles
    match /territory/{docId} {
      allow read, write: if true;
    }
    
    // Allow read and write for 12 SPM indicators
    match /spm/{indicatorId} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
